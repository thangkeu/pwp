# PWP — biến môi trường mẫu. Copy thành `.env` và điền giá trị thật, KHÔNG commit `.env`.

# --- Gateway chung ---
LOG_LEVEL=info
GATEWAY_API_KEY=change-me-to-a-strong-random-string

# --- Event Bus (mới ở Sprint 0.3) ---
# memory: dùng InMemoryTransport, không cần Redis (dev nhanh, KHÔNG dùng production nhiều instance)
# redis:  dùng RedisStreamsTransport, bắt buộc REDIS_URL trỏ đúng container redis
EVENT_BUS_DRIVER=redis
REDIS_URL=redis://redis:6379

# --- Parser Service (mới ở Sprint 1.1) ---
PARSER_OCR_LANGUAGES=eng+vie
PARSER_MAX_UPLOAD_MB=50
# Chỉ cần đặt khi chạy Parser Service NGOÀI Docker (vd: local trên Windows) và tesseract.exe
# không tự nằm trong PATH. Để trống khi chạy qua Docker (image đã cài tesseract-ocr qua apt).
# Windows ví dụ: C:\Program Files\Tesseract-OCR\tesseract.exe
PARSER_TESSERACT_CMD=

# --- Metadata Service (mới ở Sprint 1.2) ---
METADATA_MAX_TEXT_LENGTH_MB=5
# Để trống = dùng dictionary mặc định trong code (vendor hạ tầng IT phổ biến, industry chung).
# Trỏ tới file JSON thật của công ty (danh sách khách hàng/dự án) nếu muốn override.
METADATA_CUSTOMER_DICT_PATH=
METADATA_PROJECT_DICT_PATH=

# --- Sẽ bổ sung ở các Sprint sau (Postgres, Qdrant, Neo4j, AI Provider keys...) ---
# POSTGRES_PASSWORD=
# CLAUDE_API_KEY=
# OPENAI_API_KEY=
